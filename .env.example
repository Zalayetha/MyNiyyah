# Local development template only. Never commit populated environment files.
# Start local PostgreSQL with: docker compose -f docker-compose.dev.yml up -d postgres

POSTGRES_USER="myniyyah"
POSTGRES_PASSWORD="CHANGE_ME_LOCAL_POSTGRES_PASSWORD"
POSTGRES_DB="myniyyah"
DATABASE_URL="postgresql://myniyyah:CHANGE_ME_LOCAL_POSTGRES_PASSWORD@localhost:55432/myniyyah"

PGADMIN_DEFAULT_EMAIL="admin@myniyyah.local"
PGADMIN_DEFAULT_PASSWORD="CHANGE_ME_LOCAL_PGADMIN_PASSWORD"

# Exactly one canonical app origin. Do not use a comma-separated list here.
BETTER_AUTH_URL="http://localhost:3000"
# Optional comma-separated additional origins, without paths.
BETTER_AUTH_TRUSTED_ORIGINS=""
# Generate with: pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET="CHANGE_ME_GENERATED_AUTH_SECRET_AT_LEAST_32_CHARACTERS"

# Public registration is disabled in code until email verification and recovery
# are configured with an approved mail provider.
