// use prisma-next
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     temporal.updatedAt()

}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  ipAddress String?
  userAgent String?
  userId    String

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             temporal.updatedAt()

  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  temporal.updatedAt()

  @@index([identifier])
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  phone     String?
  cityName  String?
  country   String   @default("Indonesia")
  bio       String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

}

model UserPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  notifyPrayer        Boolean  @default(true)
  notifyJournal       Boolean  @default(true)
  vibrateOnPray       Boolean  @default(true)
  journalReminderTime String   @default("20:00")
  createdAt           DateTime @default(now())
  updatedAt           temporal.updatedAt()

}

model UserLocationPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  cityId              String?
  cityName            String
  province            String?
  country             String   @default("Indonesia")
  latitude            Float?
  longitude           Float?
  timezone            String
  timezoneOffset      Int
  calculationMethodId String
  source              String   @default("manual")
  createdAt           DateTime @default(now())
  updatedAt           temporal.updatedAt()

  @@index([calculationMethodId])
  @@check(name: "valid_location_coordinates", expression: "(latitude IS NULL AND longitude IS NULL) OR (latitude BETWEEN -90 AND 90 AND longitude BETWEEN -180 AND 180)")
  @@check(name: "valid_location_timezone", expression: "timezone ~ '^[A-Za-z0-9_+.-]+(/[A-Za-z0-9_+.-]+)+$'")
  @@check(name: "valid_location_timezone_offset", expression: "timezoneOffset BETWEEN -14 AND 14")
  @@check(name: "valid_location_source", expression: "source IN ('manual', 'auto')")
}
model PrayerCalculationMethod {
  id                  String   @id
  name                String
  description         String
  fajrAngle           Float?
  ishaAngle           Float?
  ishaIntervalMinutes Int?
  createdAt           DateTime @default(now())
  updatedAt           temporal.updatedAt()
  @@check(name: "valid_calculation_angles", expression: "(fajrAngle IS NULL OR fajrAngle BETWEEN 0 AND 90) AND (ishaAngle IS NULL OR ishaAngle BETWEEN 0 AND 90)")
  @@check(name: "valid_isha_interval", expression: "ishaIntervalMinutes IS NULL OR ishaIntervalMinutes BETWEEN 0 AND 1440")
}

model CityCatalog {
  id             String   @id
  name           String
  province       String
  country        String   @default("Indonesia")
  latitude       Float?
  longitude      Float?
  timezone       String
  timezoneOffset Int
  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  @@index([name])
  @@index([province])
  @@check(name: "valid_city_coordinates", expression: "(latitude IS NULL AND longitude IS NULL) OR (latitude BETWEEN -90 AND 90 AND longitude BETWEEN -180 AND 180)")
  @@check(name: "valid_city_timezone", expression: "timezone ~ '^[A-Za-z0-9_+.-]+(/[A-Za-z0-9_+.-]+)+$'")
  @@check(name: "valid_city_timezone_offset", expression: "timezoneOffset BETWEEN -14 AND 14")
}

model PrayerSchedule {
  id                  String   @id @default(uuid())
  locationKey         String
  prayerDate          String
  prayerName          String
  scheduledAt         DateTime
  timezone            String
  calculationMethodId String
  createdAt           DateTime @default(now())
  updatedAt           temporal.updatedAt()

  @@unique([locationKey, prayerDate, prayerName, calculationMethodId])
  @@index([prayerDate])
  @@index([calculationMethodId])
  @@check(name: "valid_schedule_date", expression: "prayerDate ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'")
  @@check(name: "valid_schedule_prayer_name", expression: "prayerName IN ('subuh', 'zhuhur', 'ashar', 'maghrib', 'isya')")
  @@check(name: "valid_schedule_timezone", expression: "timezone ~ '^[A-Za-z0-9_+.-]+(/[A-Za-z0-9_+.-]+)+$'")
}

model PrayerLog {
  id           String    @id @default(uuid())
  userId       String
  prayerDate   String
  prayerName   String
  scheduledAt  DateTime?
  completedAt  DateTime?
  status       String    @default("pending")
  feeling      String?
  feelingScore Int?
  khusyuScore  Int?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    temporal.updatedAt()

  @@unique([userId, prayerDate, prayerName])
  @@index([userId, prayerDate])
  @@index([userId, status])
  @@check(name: "valid_prayer_log_status", expression: "status IN ('pending', 'completed')")
  @@check(name: "valid_prayer_log_date", expression: "prayerDate ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'")
  @@check(name: "valid_prayer_log_name", expression: "prayerName IN ('subuh', 'zhuhur', 'ashar', 'maghrib', 'isya')")
  @@check(name: "valid_prayer_log_scores", expression: "(feelingScore IS NULL OR feelingScore BETWEEN 1 AND 4) AND (khusyuScore IS NULL OR khusyuScore BETWEEN 1 AND 4)")
}
model JournalTheme {
  id        String   @id
  slug      String   @unique
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

}

model JournalEntry {
  id                    String   @id @default(uuid())
  userId                String
  journalDate           String
  themeId               String?
  title                 String
  content               String
  khusyuPercentage      Int?
  punctualityPercentage Int?
  createdAt             DateTime @default(now())
  updatedAt             temporal.updatedAt()

  @@unique([userId, journalDate])
  @@index([userId, journalDate])
  @@index([themeId])
  @@check(name: "valid_journal_date", expression: "journalDate ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'")
  @@check(name: "valid_journal_percentages", expression: "(khusyuPercentage IS NULL OR khusyuPercentage BETWEEN 0 AND 100) AND (punctualityPercentage IS NULL OR punctualityPercentage BETWEEN 0 AND 100)")
}

model JournalPrayerReflection {
  id                String    @id @default(uuid())
  journalEntryId    String
  prayerLogId       String?
  prayerName        String
  adzanAt           DateTime?
  completedAt       DateTime?
  differenceMinutes Int?
  punctuality       String?
  feeling           String?
  feelingScore      Int?
  khusyuScore       Int?
  createdAt         DateTime  @default(now())
  updatedAt         temporal.updatedAt()

  @@unique([journalEntryId, prayerName])
  @@index([prayerLogId])
  @@check(name: "valid_reflection_prayer_name", expression: "prayerName IN ('subuh', 'zhuhur', 'ashar', 'maghrib', 'isya')")
  @@check(name: "valid_reflection_scores", expression: "(feelingScore IS NULL OR feelingScore BETWEEN 1 AND 4) AND (khusyuScore IS NULL OR khusyuScore BETWEEN 1 AND 4)")
  @@check(name: "valid_reflection_punctuality", expression: "punctuality IS NULL OR punctuality IN ('Belum Dicatat', 'Awal Waktu', 'Tepat Waktu', 'Terlambat')")
}
model KhazanahCategory {
  id        String   @id
  slug      String   @unique
  title     String
  subtitle  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

}

model KhazanahVerse {
  id               String   @id
  categoryId       String
  title            String
  surahName        String
  surahTranslation String
  juz              Int
  surahNumber      Int
  verseNumber      Int
  arabic           String
  translation      String
  reference        String
  createdAt        DateTime @default(now())
  updatedAt        temporal.updatedAt()

  @@index([categoryId])
  @@index([surahNumber, verseNumber])

}
model KhazanahVerseSegment {
  id        String   @id @default(uuid())
  verseId   String
  position  Int
  text      String
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@unique([verseId, position])
  @@index([verseId])
  @@check(name: "valid_verse_segment_position", expression: "position > 0")
}

model JournalAttachedVerse {
  id             String   @id @default(uuid())
  journalEntryId String
  verseId        String
  segmentId      String?
  quoteText      String
  surahRef       String
  createdAt      DateTime @default(now())

  @@unique([journalEntryId, verseId, segmentId])
  @@index([verseId])
}
